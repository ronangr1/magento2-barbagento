/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Ronangr1\Barbagento\ViewModel\Init $viewModel
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Ronangr1\Barbagento\ViewModel\Init || !$viewModel->isApplicable()) {
    return;
}

$settings = $viewModel->getSettings();

$debug = $settings->getDebug() ? 'true' : 'false';
$timeout = (int)$settings->getTimeout();
if ($timeout <= 0) {
    $timeout = 7000;
}
$excludedPages = (string)$settings->getExcludedPages();
if ($excludedPages === '' || $excludedPages === 'null') {
    $excludedPages = '[]';
}

$gtagEnable = $settings->getGtagEnable() ? 'true' : 'false';
$gtagId = $escaper->escapeJs((string)$settings->getGtagId());

$scriptString = <<<script
    require(['Ronangr1_Barbagento/js/barba-init'], function (MagentoBarba) {
        const config = {
            debug: {$debug},
            timeout: {$timeout},
            excludedPages: {$excludedPages},
            gtagEnable: {$gtagEnable},
            gtagId: '{$gtagId}'
        };
        MagentoBarba.init(config);
    });
script;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
