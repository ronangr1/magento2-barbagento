/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Ronangr1\Barbagento\ViewModel\Init $viewModel
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Ronangr1\Barbagento\ViewModel\Init) {
    return;
}

$settings = $viewModel->getSettings();
$gtagId = trim((string)$settings->getGtagId());
if ($gtagId === '') {
    return;
}

$escapedGtagIdJs = $escaper->escapeJs($gtagId);
$escapedSrc = 'https://www.googletagmanager.com/gtag/js?id=' . $escaper->escapeUrl($gtagId);

$gtagScript = <<<script
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{$escapedGtagIdJs}');
script;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', ['async' => 'async', 'src' => $escapedSrc], '', false) ?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $gtagScript, false) ?>
